# AMT backend — AI assistant API
PORT=8787

# ============ AI provider ============
# Leave everything blank to use the built-in grounded offline responder (no AI, no key).
# To use a FREE AI model, set AI_PROVIDER + AI_API_KEY:
#
#   groq        FREE, fast, no credit card  -> https://console.groq.com  (recommended)
#   gemini      FREE tier (Google)          -> https://aistudio.google.com/apikey
#   openrouter  FREE models                 -> https://openrouter.ai/keys
#   ollama      100% local & free, no key    -> https://ollama.com  (run: ollama pull llama3.2)
#
# AI_PROVIDER=groq
# AI_API_KEY=your_free_key_here
#
# Optional overrides (otherwise sensible per-provider defaults are used):
# AI_MODEL=llama-3.3-70b-versatile
# AI_BASE_URL=

# ============ Inquiry emails (optional) ============
# Where customer inquiries from the assistant are sent. Without SMTP, inquiries
# are logged and the customer still gets a one-tap WhatsApp handoff.
# LEAD_TO=info@amt-arabia.net
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_user
# SMTP_PASS=your_smtp_password
# SMTP_FROM=info@amt-arabia.net

# Locked CORS (comma-separated). Defaults to localhost + amt-arabia.net.
# ALLOWED_ORIGINS=https://amt-arabia.net,https://www.amt-arabia.net
